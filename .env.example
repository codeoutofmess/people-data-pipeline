# Copy to .env and adjust. Never commit .env.
# Local Homebrew Postgres needs no password; this is the default if unset.
DATABASE_URL=postgresql:///people
TEST_DATABASE_URL=postgresql:///people_test

# Demo API tokens, read by `people seed-users`. Pick your own long random values in .env,
# for example: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DEMO_TOKEN_PEOPLE_ADMIN=
DEMO_TOKEN_MANAGER=
DEMO_TOKEN_VIEWER=
